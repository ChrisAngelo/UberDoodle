# Copy to .env.local and fill in. Never commit real values.

# --- Frontend (Vite) ---
# Gemini key. WARNING: it is bundled into the browser JS (see vite.config.ts) - local use only.
GEMINI_API_KEY=
# Optional model overrides (defaults live in services/geminiService.ts GEMINI_MODELS)
# VITE_GEMINI_TEXT_MODEL=
# VITE_GEMINI_TEXT_FAST_MODEL=
# VITE_GEMINI_IMAGE_MODEL=
# VITE_GEMINI_TTS_MODEL=
# Optional direct TTS providers. WARNING: VITE_* values are bundled into browser JS - local use only.
VITE_LMNT_API_KEY=
VITE_ELEVENLABS_API_KEY=
# Prefer setting GENAIPRO_JWT for the proxy below; this browser copy only flags GenAiPro as available.
VITE_GENAIPRO_JWT=
# VITE_TTS_PROXY_URL=http://localhost:3002/proxy
# Optional: bind the dev server to the LAN instead of 127.0.0.1
# VITE_HOST=0.0.0.0

# Providers (all of these can also be set in the app: gear icon -> Settings, which persists them)
# VITE_TEXT_PROVIDER=gemini        # gemini | lmstudio | unsloth
# VITE_IMAGE_PROVIDER=gemini       # gemini | kie
# VITE_VIDEO_PROVIDER=gemini       # gemini | kie
# VITE_LMSTUDIO_URL=http://localhost:1234/v1
# VITE_LMSTUDIO_MODEL=
# VITE_UNSLOTH_URL=http://localhost:8080/v1
# VITE_UNSLOTH_MODEL=
# VITE_KIE_IMAGE_MODEL=nano-banana-pro
# VITE_KIE_VIDEO_MODEL=veo3_fast

# --- CORS proxy (cors-proxy.mjs) ---
# Kie.ai key (Nano Banana + Veo 3). Or save it in the app's Settings (stored in .uberdoodle-secrets.json).
KIE_API_KEY=
# KIE_API_URL=https://api.kie.ai
# KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-base64-upload
# KIE_FILE_HOST_ALLOWLIST=kie.ai,*.kie.ai,*.aiquickdraw.com,*.redpandaai.co,storage.googleapis.com,*.r2.dev,*.cloudfront.net
# GenAiPro bearer token (JWT). Required for /proxy/genaipro/*.
GENAIPRO_JWT=
# PROXY_PORT=3002
# PROXY_HOST=127.0.0.1
# PROXY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AUDIO_HOST_ALLOWLIST=genaipro.vn,*.genaipro.vn,storage.googleapis.com,*.r2.dev,*.cloudfront.net

# --- Python backend (main.py) ---
# GCP_PROJECT_ID=your-project
# GCP_LOCATION=us-central1
# MODEL_NAME=gemini-1.5-pro
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# API_HOST=127.0.0.1
# API_PORT=8000
# ALLOWED_ORIGINS=http://localhost:5173
# ENABLE_DEMO=0
